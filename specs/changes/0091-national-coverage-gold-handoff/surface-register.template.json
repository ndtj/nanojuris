{
  "schema_version": "1.0",
  "surface_id_format": "authority/branch/degree/instance/collection/document_scope",
  "required": [
    "surface_id",
    "authority",
    "branch",
    "degree",
    "instance",
    "collection",
    "provider",
    "lifecycle",
    "maturity",
    "contract_status",
    "live_status",
    "quality_status",
    "document_capability",
    "federation_status",
    "legal_status",
    "last_live_check",
    "evidence_ids",
    "evidence_ttl",
    "owner",
    "next_action"
  ],
  "allowed_statuses": {
    "lifecycle": ["cataloged", "candidate", "implemented", "rejected", "source_unavailable"],
    "contract_status": ["pending", "valid", "invalid", "blocked", "source_unavailable"],
    "live_status": ["not_checked", "valid", "authoritative_empty", "unconfirmed_empty", "access_blocked", "rate_limited", "timeout", "transport_error", "schema_invalid", "partial"],
    "federation_status": ["disabled", "opt_in", "enabled", "blocked", "legal_pending"],
    "document_capability": ["inline_text", "detail_api", "document_link", "public_download", "ocr_required", "not_offered_by_source", "access_blocked", "source_unavailable"],
    "legal_status": ["not_reviewed", "human_review", "approved", "rejected"]
  },
  "example": {
    "surface_id": "TJXX/state/second/second/CJSG/general",
    "authority": "TJXX",
    "branch": "state",
    "degree": "second",
    "instance": "second",
    "collection": "CJSG",
    "provider": "provider_id",
    "lifecycle": "candidate",
    "maturity": "bronze",
    "contract_status": "pending",
    "live_status": "not_checked",
    "quality_status": "pending",
    "document_capability": "source_unavailable",
    "federation_status": "disabled",
    "legal_status": "human_review",
    "last_live_check": null,
    "evidence_ids": [],
    "evidence_ttl": null,
    "owner": null,
    "next_action": "discover_official_source"
  }
}
