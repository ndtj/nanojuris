{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanojuris.dev/schemas/tombstone-evidence-v1.schema.json",
  "title": "NanoJuris Tombstone Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "canonical_key",
    "evidence_url",
    "evidence_sha256",
    "evidence_type",
    "observed_at",
    "reason",
    "schema_version"
  ],
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "canonical_key": { "type": "string", "minLength": 1 },
    "evidence_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "official_tombstone",
        "official_absence_manifest",
        "explicit_retraction"
      ]
    },
    "observed_at": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "schema_version": {
      "const": "nanojuris-tombstone-evidence-v1"
    }
  }
}
