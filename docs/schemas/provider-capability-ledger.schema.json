{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanojuris.dev/schemas/provider-capability-ledger-v1.json",
  "title": "NanoJuris provider capability ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "mode", "inputs", "summary", "providers"],
  "properties": {
    "schema_version": {"const": "provider-capability-ledger-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "mode": {"const": "offline_reconciliation"},
    "inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/input"}},
    "summary": {"type": "object", "required": ["providers", "runtime", "candidates", "families"], "properties": {
      "providers": {"type": "integer", "minimum": 0},
      "runtime": {"type": "integer", "minimum": 0},
      "candidates": {"type": "integer", "minimum": 0},
      "families": {"type": "integer", "minimum": 0}
    }, "additionalProperties": true},
    "providers": {"type": "array", "items": {"$ref": "#/$defs/provider"}}
  },
  "$defs": {
    "input": {"type": "object", "required": ["path", "sha256", "record_count"], "properties": {
      "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "record_count": {"type": "integer", "minimum": 0}
    }, "additionalProperties": true},
    "provider": {"type": "object", "required": ["source_id", "classification", "contract", "data", "document", "gaps", "workpack"], "properties": {
      "source_id": {"type": "string", "minLength": 1},
      "display_name": {"type": "string"},
      "classification": {"type": "object", "required": ["lifecycle", "implementation_status", "coverage_role", "runtime"], "properties": {
        "lifecycle": {"type": "string"}, "implementation_status": {"type": "string"}, "coverage_role": {"type": "string"}, "runtime": {"type": "boolean"}, "category": {"type": "string"}
      }, "additionalProperties": true},
      "maturity": {"type": "object", "additionalProperties": true},
      "live": {"type": "object", "additionalProperties": true},
      "contract": {"type": "object", "required": ["supports_unified_search", "filters"], "properties": {
        "supports_unified_search": {"type": "boolean"},
        "filters": {"type": "object", "required": ["native", "unsupported", "unverified"], "additionalProperties": true}
      }, "additionalProperties": true},
      "data": {"type": "object", "required": ["canonical_records", "extracted_fields"], "properties": {"canonical_records": {"type": "array", "items": {"type": "string"}}, "extracted_fields": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
      "document": {"type": "object", "required": ["supports_full_text", "full_text_access"], "properties": {"supports_full_text": {"type": "boolean"}, "full_text_access": {"type": "string"}}, "additionalProperties": true},
      "evidence": {"type": "object", "additionalProperties": true},
      "gaps": {"type": "array", "items": {"type": "string"}},
      "workpack": {"type": "object", "required": ["wave", "tasks"], "properties": {"wave": {"type": "string"}, "tasks": {"type": "array", "items": {"type": "object", "required": ["id", "status"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": true}}}, "additionalProperties": true}
    }, "additionalProperties": true}
  }
}
