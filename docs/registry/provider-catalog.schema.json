{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanojuris.org/schemas/provider-catalog.full.json",
  "title": "NanoJuris provider coverage catalog",
  "type": "object",
  "required": ["schema_version", "generated_at", "scope", "summary", "entries"],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "scope": {
      "type": "object",
      "required": ["product", "primary_goal", "out_of_scope"],
      "properties": {
        "product": {"type": "string"},
        "primary_goal": {"type": "string"},
        "out_of_scope": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "total_sources",
        "implemented_sources",
        "unified_search_sources",
        "primary_textual_sources",
        "sources_with_full_text",
        "by_lifecycle",
        "by_maturity_tier",
        "by_coverage_role",
        "by_latest_live_status"
      ],
      "additionalProperties": true
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/providerEntry"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "providerEntry": {
      "type": "object",
      "required": [
        "source_id",
        "lifecycle",
        "display_name",
        "category",
        "identity",
        "implementation_status",
        "offline_status",
        "live_status",
        "coverage_role",
        "maturity_tier",
        "maturity_score",
        "development_priority",
        "documentation",
        "live_validation",
        "live_evidence",
        "input_contract",
        "output_contract",
        "search_contract",
        "document_contract",
        "pagination_contract",
        "error_contract",
        "quality_contract",
        "known_defects",
        "recommended_for",
        "not_recommended_for",
        "interfaces",
        "mcp",
        "studio",
        "jurimetry",
        "ai_usage",
        "source_contract"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "lifecycle": {
          "enum": ["implemented", "candidate", "family", "unknown"]
        },
        "display_name": {"type": "string"},
        "category": {"type": "string"},
        "identity": {
          "type": "object",
          "required": ["source_id", "display_name", "source_url", "category"],
          "properties": {
            "source_id": {"type": "string"},
            "display_name": {"type": "string"},
            "source_url": {"type": ["string", "null"], "format": "uri"},
            "category": {"type": "string"}
          },
          "additionalProperties": false
        },
        "implementation_status": {"enum": ["runtime", "none", "family", "unknown"]},
        "offline_status": {"enum": ["complete", "partial", "missing", "not_applicable"]},
        "live_status": {"type": "string"},
        "coverage_role": {"type": "string"},
        "maturity_tier": {
          "enum": ["gold", "silver", "bronze", "context", "mapped", "blocked", "family"]
        },
        "maturity_score": {
          "type": "object",
          "required": ["total", "grade", "dimensions", "blockers", "next_actions"],
          "properties": {
            "total": {"type": "integer", "minimum": 0, "maximum": 100},
            "grade": {"enum": ["A", "B", "C", "D"]},
            "dimensions": {"type": "object"},
            "blockers": {"type": "array", "items": {"type": "string"}},
            "next_actions": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "development_priority": {"type": "string"},
        "documentation": {"type": "object"},
        "live_validation": {"type": "object"},
        "live_evidence": {"type": "object"},
        "input_contract": {"type": "object"},
        "output_contract": {"type": "object"},
        "search_contract": {"type": "object"},
        "document_contract": {
          "type": "object",
          "required": ["supports_full_text", "document_types", "content_formats", "trace_expected"],
          "properties": {
            "supports_full_text": {"type": "boolean"},
            "document_types": {"type": "array", "items": {"type": "string"}},
            "content_formats": {"type": "array", "items": {"type": "string"}},
            "trace_expected": {"type": "boolean"},
            "full_text_access": {"type": "string"}
          },
          "additionalProperties": false
        },
        "pagination_contract": {
          "type": "object",
          "required": ["mode", "declared"],
          "properties": {
            "mode": {"type": "string"},
            "declared": {"type": "boolean"},
            "max_remote_page": {"type": ["integer", "null"], "minimum": 1},
            "max_remote_page_size": {"type": ["integer", "null"], "minimum": 1}
          },
          "additionalProperties": false
        },
        "error_contract": {"type": "object"},
        "quality_contract": {"type": "object"},
        "known_defects": {"type": "array", "items": {"type": "string"}},
        "recommended_for": {"type": "array", "items": {"type": "string"}},
        "not_recommended_for": {"type": "array", "items": {"type": "string"}},
        "interfaces": {"type": "object"},
        "mcp": {"type": "object"},
        "studio": {"type": "object"},
        "jurimetry": {"type": "object"},
        "ai_usage": {"type": "object"},
        "source_contract": {
          "anyOf": [
            {"type": "object"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
