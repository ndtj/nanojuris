{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanojuris.org/schemas/provider-catalog.full.json",
  "title": "NanoJuris provider coverage catalog",
  "type": "object",
  "required": ["schema_version", "generated_at", "scope", "summary", "entries"],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "scope": {
      "type": "object",
      "required": ["product", "primary_goal", "out_of_scope"],
      "properties": {
        "product": {"type": "string"},
        "primary_goal": {"type": "string"},
        "out_of_scope": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "total_sources",
        "implemented_sources",
        "unified_search_sources",
        "primary_textual_sources",
        "sources_with_full_text",
        "by_lifecycle",
        "by_maturity_tier",
        "by_coverage_role",
        "by_latest_live_status"
      ],
      "additionalProperties": true
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/providerEntry"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "providerEntry": {
      "type": "object",
      "required": [
        "source_id",
        "lifecycle",
        "display_name",
        "category",
        "coverage_role",
        "maturity_tier",
        "development_priority",
        "documentation",
        "live_validation",
        "input_contract",
        "output_contract",
        "interfaces",
        "jurimetry",
        "ai_usage",
        "source_contract"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "lifecycle": {
          "enum": ["implemented", "candidate", "family", "unknown"]
        },
        "display_name": {"type": "string"},
        "category": {"type": "string"},
        "coverage_role": {"type": "string"},
        "maturity_tier": {
          "enum": ["gold", "silver", "bronze", "context", "mapped", "blocked", "family"]
        },
        "development_priority": {"type": "string"},
        "documentation": {"type": "object"},
        "live_validation": {"type": "object"},
        "input_contract": {"type": "object"},
        "output_contract": {"type": "object"},
        "interfaces": {"type": "object"},
        "jurimetry": {"type": "object"},
        "ai_usage": {"type": "object"},
        "source_contract": {
          "anyOf": [
            {"type": "object"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
